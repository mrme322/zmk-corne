#undef ZMK_BEHAVIORS_KEEP_ALL

#define ZMK_BEHAVIORS_KEEP_SK
#define ZMK_BEHAVIORS_KEEP_MT
#define ZMK_BEHAVIORS_KEEP_KT
#define ZMK_POINTING_DEFAULT_MOVE_VAL 1500  // default: 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 20    // default: 10

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>

&sk {
    quick-release;
    release-after-ms = <1500>;
};

/ {
    combos {
        compatible = "zmk,combos";

        escL {
            timeout-ms = <50>;
            bindings = <&kp ESCAPE>;
            key-positions = <3 4>;
            require-prior-idle-ms = <100>;
            layers = <0>;
        };

        adjL {
            timeout-ms = <200>;
            bindings = <&mo 8>;
            key-positions = <5 1>;
            layers = <0>;
        };

        backR {
            bindings = <&kp BACKSPACE>;
            key-positions = <19 20>;
            timeout-ms = <50>;
            require-prior-idle-ms = <100>;
            layers = <0 5 7 6>;
        };

        backL {
            bindings = <&kp BACKSPACE>;
            key-positions = <16 15>;
            timeout-ms = <50>;
            require-prior-idle-ms = <100>;
            layers = <0 5 7 6>;
        };

        questionR {
            bindings = <&kp QUESTION>;
            key-positions = <33 32>;
            timeout-ms = <50>;
            require-prior-idle-ms = <100>;
            layers = <0>;
        };

        wordDel {
            bindings = <&kp LC(BACKSPACE)>;
            key-positions = <15 14>;
            timeout-ms = <50>;
            require-prior-idle-ms = <100>;
            layers = <0 5 7 6>;
        };

        delR {
            bindings = <&kp DELETE>;
            key-positions = <31 32>;
            timeout-ms = <50>;
            require-prior-idle-ms = <100>;
            layers = <0 5 7 6>;
        };

        wordDelR {
            bindings = <&kp LC(BACKSPACE)>;
            key-positions = <20 21>;
            timeout-ms = <50>;
            require-prior-idle-ms = <100>;
            layers = <0 5 7 6>;
        };

        capsWord {
            bindings = <&caps_word>;
            key-positions = <16 19>;
            timeout-ms = <150>;
            require-prior-idle-ms = <100>;
            layers = <0>;
        };

        delL {
            bindings = <&kp DELETE>;
            key-positions = <27 28>;
            timeout-ms = <50>;
            require-prior-idle-ms = <100>;
            layers = <0 5 7 6>;
        };

        toSym {
            bindings = <&mo 7>;
            key-positions = <37 40>;
            timeout-ms = <50>;
            slow-release;
            require-prior-idle-ms = <100>;
            layers = <0>;
        };

        toIpadSC {
            bindings = <&mo 4>;
            key-positions = <38 39>;
            timeout-ms = <50>;
            slow-release;
            require-prior-idle-ms = <100>;
            layers = <0>;
        };

        quotes {
            bindings = <&kp SINGLE_QUOTE>;
            key-positions = <8 9>;
            timeout-ms = <50>;
            require-prior-idle-ms = <100>;
            layers = <0>;
        };

        leftEnter {
            bindings = <&kp ENTER>;
            key-positions = <26 27>;
            timeout-ms = <50>;
            require-prior-idle-ms = <100>;
            layers = <0>;
        };
    };

    behaviors {
        hmr: hmr {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            label = "hmr";
            bindings = <&kp>, <&kp>;

            tapping-term-ms = <280>;
            hold-trigger-key-positions = <0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 36 37 38 39 40 41>;
            hold-trigger-on-release;             // delay positional check until key-release
            flavor = "balanced";
            require-prior-idle-ms = <150>;
            require-prior-idle-ms = <150>;
            quick-tap-ms = <175>;
        };

        hml: hml {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            label = "hml";
            bindings = <&kp>, <&kp>;

            tapping-term-ms = <280>;
            hold-trigger-key-positions = <6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35 39 40 41 36 37 38>;
            hold-trigger-on-release;
            flavor = "balanced";
            require-prior-idle-ms = <150>;
            quick-tap-ms = <175>;
        };

        stickShiftlt: stickShiftlt {
            compatible = "zmk,behavior-hold-tap";
            label = "STICKSHIFTLT";
            bindings = <&mo>, <&sk>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "balanced";
            retro-tap;
            hold-while-undecided;
        };

        tapSkSh2tapWiholdLayer: tapSkSh2tapWiholdLayer {
            compatible = "zmk,behavior-tap-dance";
            label = "TAPSKSH2TAPWIHOLDLAYER";
            #binding-cells = <0>;
            bindings = <&stickShiftlt 2 LEFT_SHIFT>, <&lt 0 LEFT_WIN>;

            tapping-term-ms = <350>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        L0 {
            bindings = <
&none  &kp Q            &kp W            &kp E                &kp R              &kp T                      &kp Y        &kp U              &kp I                &kp O            &kp P                    &none
&none  &hml LEFT_GUI A  &hml LEFT_ALT S  &hml LEFT_CONTROL D  &hml LEFT_SHIFT F  &kp G                      &kp H        &hmr LEFT_SHIFT J  &hmr LEFT_CONTROL K  &hmr LEFT_ALT L  &hmr LEFT_GUI SEMICOLON  &none
&none  &kp Z            &kp X            &kp C                &kp V              &kp B                      &kp N        &kp M              &kp COMMA            &kp DOT          &kp SLASH                &none
                                         &none                &lt 3 TAB          &tapSkSh2tapWiholdLayer    &lt 5 SPACE  &lt 6 RET          &none
            >;
        };

        L0noHMR {
            bindings = <
&none  &kp Q  &kp W  &kp E  &kp R      &kp T                      &kp Y        &kp U      &kp I      &kp O    &kp P      &none
&none  &kp A  &kp S  &kp D  &kp F      &kp G                      &kp H        &kp J      &kp K      &kp L    &kp SEMI   &none
&none  &kp Z  &kp X  &kp C  &kp V      &kp B                      &kp N        &kp M      &kp COMMA  &kp DOT  &kp SLASH  &none
                     &none  &lt 3 TAB  &tapSkSh2tapWiholdLayer    &lt 5 SPACE  &lt 6 RET  &none
            >;
        };

        winSC {
            bindings = <
&none  &kp LC(LG(F4))  &kp LG(TAB)    &kp LC(LG(LEFT))  &kp LC(LG(RIGHT))  &kp LC(LG(D))    &none  &none      &none      &none     &none         &none
&none  &kp LC(A)       &kp LC(X)      &kp LC(C)         &kp LC(V)          &kp LG(E)        &none  &kp LSHFT  &kp LCTRL  &kp LALT  &kp LEFT_WIN  &none
&none  &kp LC(Z)       &kp C_AC_HOME  &kp LG(LS(S))     &kp LG(D)          &kp LA(F4)       &none  &sk LSHFT  &sk LCTRL  &sk LALT  &sk LEFT_WIN  &none
                                      &none             &none              &none            &none  &none      &none
            >;
        };

        fn_mods {
            bindings = <
&none  &kp HOME       &kp F7  &kp F8  &kp F9  &kp F12    &none            &none           &none      &none     &none         &none
&none  &kp LS(LC(H))  &kp F4  &kp F5  &kp F6  &kp F11    &kp PRINTSCREEN  &kp LEFT_SHIFT  &kp LCTRL  &kp LALT  &kp LEFT_GUI  &none
&none  &key_repeat    &kp F1  &kp F2  &kp F3  &kp F10    &kp CAPS         &sk LEFT_SHIFT  &sk LCTRL  &sk LALT  &sk LEFT_GUI  &none
                              &none   &none   &none      &none            &none           &none
            >;
        };

        ipadSC {
            bindings = <
&none  &none      &none      &none                 &none      &none    &none  &none  &none  &none  &none  &none
&none  &kp LG(A)  &kp LG(X)  &kp LG(C)             &kp LG(V)  &none    &none  &none  &none  &none  &none  &none
&none  &kp LG(Z)  &none      &kp LG(LS(NUMBER_4))  &kp LG(H)  &none    &none  &none  &none  &none  &none  &none
                             &none                 &none      &none    &none  &none  &none
            >;
        };

        num {
            bindings = <
&none  &none         &none     &none      &none           &none    &kp PLUS   &kp N7      &kp N8     &kp N9  &kp STAR   &none
&none  &kp LEFT_GUI  &kp LALT  &kp LCTRL  &kp LEFT_SHIFT  &none    &kp MINUS  &kp N4      &kp N5     &kp N6  &kp SLASH  &none
&none  &sk LEFT_GUI  &sk LALT  &sk LCTRL  &sk LEFT_SHIFT  &none    &kp N0     &kp N1      &kp N2     &kp N3  &kp EQUAL  &none
                               &none      &none           &none    &none      &kp PERIOD  &kp ENTER
            >;
        };

        nav-media {
            bindings = <
&none  &none         &none     &none      &none           &none    &kp C_VOL_UP  &kp PG_UP   &kp UP      &kp PG_DN   &kp C_MUTE          &none
&none  &kp LEFT_GUI  &kp LALT  &kp LCTRL  &kp LEFT_SHIFT  &none    &kp HOME      &kp LEFT    &kp DOWN    &kp RIGHT   &kp END             &none
&none  &sk LEFT_GUI  &sk LALT  &sk LCTRL  &sk LEFT_SHIFT  &none    &kp C_VOL_DN  &kp C_PREV  &kp C_PLAY  &kp C_NEXT  &kp K_CONTEXT_MENU  &none
                               &none      &none           &none    &none         &none       &none
            >;
        };

        symb {
            bindings = <
&none  &kp EXCL      &kp AT    &kp HASH       &kp DLLR        &kp SQT              &kp PLUS   &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &kp GRAVE  &kp STAR   &none
&none  &kp LEFT_GUI  &kp LALT  &kp LCTRL      &kp LEFT_SHIFT  &none                &kp MINUS  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp UNDER  &kp SLASH  &none
&none  &kp CARET     &kp AMPS  &kp BACKSLASH  &kp PERCENT     &kp DOUBLE_QUOTES    &kp PIPE   &kp LEFT_BRACE        &kp RIGHT_BRACE        &kp TILDE  &kp EQUAL  &none
                               &none          &none           &none                &none      &none                 &none
            >;
        };

        adj {
            bindings = <
&none  &none  &none  &none  &none  &none          &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2   &bt BT_SEL 3  &bt BT_SEL 4    &none
&none  &none  &none  &none  &none  &none          &none         &kp C_BRI_UP  &kp C_BRI_DEC  &none         &bt BT_CLR      &none
&none  &none  &none  &none  &none  &none          &none         &none         &none          &none         &studio_unlock  &none
                     &none  &none  &bootloader    &bootloader   &out OUT_TOG  &none
            >;
        };
    };
};
